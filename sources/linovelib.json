          "sort": "postdate"
        }
      },
      {
        "id": "postdate",
        "name": "最新入库",
        "facets": {
          "sort": "postdate"
        }
      },
      {
        "id": "lastupdate",
        "name": "最近更新",
        "facets": {
          "sort": "lastupdate"
        }
      },
      {
        "id": "monthflower",
        "name": "月鲜花榜",
