  "detail": {
    "catalogUrl": "/novel/{{id}}/catalog",
    "rules": {
      "name": "h1.book-name@text",
      "cover": ".book-cover img, .book-img img@src",
      "author": ".book-rand-a, .book-author@text",
      "intro": ".book-dec > p@text",
      "category": "meta[property=\"og:novel:category\"]@content",
      "status": "meta[property=\"og:novel:status\"]@content",
      "updateTime": "meta[property=\"og:novel:update_time\"]@content",
      "latestChapter": "meta[property=\"og:novel:latest_chapter_name\"]@content"
    },
    "url": "/novel/{{id}}.html"
  },
  "catalog": {
    "list": ".chapter-list a[href*=\"/novel/\"]",
    "name": "@text",
    "url": "@href"
  },
  "content": {
    "container": "div#TextContent",
    "removeLinesMatching": [],
    "unavailable": ".center-note"
  },
