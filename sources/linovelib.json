{
  "id": "linovelib",
  "name": "哔哩轻小说",
  "lang": "zh-CN",
  "baseUrl": "https://www.linovelib.com",
  "headers": {
    "Accept-Language": "zh-CN,zh;q=0.9"
  },
  "bookIdPattern": "/novel/(\\d+)",
  "search": {
    "url": "/S6/",
    "method": "POST",
    "rules": {
      "list": ".search-result-list",
      "name": ".tit a@text",
      "url": ".tit a@href",
      "author": ".bookinfo a@text"
    },
    "body": "searchkey={{key}}",
    "needsBrowser": true,
    "blockedUrls": [
      "*://hm.baidu.com/*"
    ],
    "readyCookie": "jieqiSearchJs"
  },
  "discover": {
    "needsBrowser": true,
    "browserNavigation": true,
    "readySelector": ".store_collist .bookbox",
    "emptySelector": ".store_collist",
    "titlePattern": "轻小说文库",
    "readyTextPattern": "[^|\\n]+\\|[^|\\n]+\\|[^|\\n]+\\|\\s*\\d{4}-\\d{2}-\\d{2}",
    "pageSize": 20,
    "upstreamPageSize": 30,
    "pagePattern": "/wenku/{sort}_{theme}_{progress}_{anime}_{region}_{imprint}_0_{words}_{page}_{updated}.html",
    "categories": [
      {
        "id": "monthvisit",
        "name": "月点击榜",
        "facets": {
          "sort": "monthvisit"
        }
      },
      {
        "id": "weekvisit",
        "name": "周点击榜",
        "facets": {
          "sort": "weekvisit"
        }
      },
