    "rules": {
      "list": ".store_collist .bookbox",
      "name": ".bookname a@text",
      "url": ".bookname a@href",
      "cover": ".bookimg img@data-original",
      "author": {
        "selector": ".bookilnk@text",
        "split": "|",
        "index": 0
      },
      "imprint": {
